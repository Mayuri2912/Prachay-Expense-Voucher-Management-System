# =====================================================================
#  Expense Voucher Management System - environment settings
#
#  1. Run  "npm run env:init"  in the project root. It copies this file
#     to ".env" and fills in a random JWT_SECRET for you.
#     (Or copy it by hand:  Copy-Item .env.example .env )
#  2. Open ".env" and set DB_PASSWORD to your own MySQL password.
#
#  This one file is read by BOTH the backend and the frontend.
#  The real ".env" is ignored by Git - never commit it.
# =====================================================================

# ---------------- Backend (Express) ----------------
NODE_ENV=development
PORT=5000

# Address(es) of the frontend that may call the API (comma separated).
CLIENT_ORIGIN=http://localhost:5173

# ---------------- MySQL ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=prachay_expense_vouchers

# ---------------- JWT ----------------
# A long random secret (at least 32 characters) used to sign login tokens.
# "npm run env:init" generates one. To make one by hand:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------------- Signature uploads ----------------
MAX_SIGNATURE_SIZE_MB=2

# ---------------- Office time zone ----------------
# Decides what "today" means for "Approved today" / "Rejected today".
APP_TIMEZONE_OFFSET=+05:30

# ---------------- Frontend (Vite) ----------------
# Only variables that start with VITE_ are visible to the browser.
VITE_API_URL=http://localhost:5000/api
